image = Image.Text(sentence, 1, 1, 1, 1, "Monospace 28", "center");
sprite = Sprite();
sprite.SetImage(image);
sprite.SetPosition((Window.GetWidth() - image.GetWidth()) / 2, (Window.GetHeight() - image.GetHeight()) / 2);