# ==========================================
# Theme Name: animframes
# Description: Plymouth theme with animated gif-like frames.
# Author: TheFabbest
#
# Features:
# - Multi-Screen Support: Works, but only first screen is used (defaults to monitor 0)
# - Password Prompt Support: No
# - Progress Display: No
# ========================================== 

# set a background color gradient
Window.SetBackgroundTopColor(0,0,0);
Window.SetBackgroundBottomColor(0,0,0);


# ------------------------- Refresh Callback --------------------------------

# 1. PRE-ALLOCATION: Load images once during startup
MAX_FRAME = 11;
frames = [];
position_x = [];
position_y = [];
window_width = Window.GetWidth();
window_height = Window.GetHeight();
i = 0;
while (i < MAX_FRAME) {
    loaded = Image("frame" + i + ".png");
    if (loaded == NULL) {
        MAX_FRAME = i;
        break;
    }
    frames[i] = loaded.Scale(loaded.GetWidth() * 4, loaded.GetHeight() * 4);

    w = frames[i].GetWidth();
    h = frames[i].GetHeight();
    position_x[i] = (window_width - w) / 2;
    position_y[i] = (window_height - h) / 2;
    
    i = i + 1;
}

# 2. SPRITE SETUP
shown = Sprite(); # Set initial image

# 3. ANIMATION LOGIC: Use a counter to slow down the animation
frame = 0;
timer = 0;
SPEED = 10; # Change this to control how fast it animates

fun refresh_callback()
{
    timer = timer + 1;
    if (timer >= SPEED) {
        frame = (frame + 1) % MAX_FRAME;
        
        shown.SetImage(frames[frame]);
        shown.SetPosition(position_x[frame], position_y[frame], 1);
        
        timer = 0;
    }
}

Plymouth.SetRefreshFunction(refresh_callback);
