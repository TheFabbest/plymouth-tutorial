# ==========================================
# Theme Name: flappy
# Description: A simple flappy bird clone for Plymouth
# Author: TheFabbest
#
# Features:
# - Multi-Screen Support: Works, but only first screen is used (defaults to monitor 0)
# - Password Prompt Support: No
# - Progress Display: No
# - Interactive: Yes (press space to make the bird jump)
# ========================================== 

# background
Window.SetBackgroundTopColor(0, 0.9, 0.9);
Window.SetBackgroundBottomColor(0, 0.9, 0.9);

# constants
acceleration = -2000;
speed_after_space = 1000;
bird_compression_max = 20;
bird_sprite_size = 96;
distance_between_tubes = 800;
tube_gap = 450;
tube_speed = 500;
window_width = Window.GetWidth();
window_height = Window.GetHeight();
SPRITES_LEVEL = 1;
TEXT_LEVEL = 2;

# game
score = 0;
game_over = 0;

# images
bird_sprite = Sprite();
bird_image = Image("bird.png");
tube_upper_image_unscaled = Image("tube_upper.png");
tube_lower_image_unscaled = Image("tube_lower.png");
tube_width = tube_upper_image_unscaled.GetWidth();
tube_upper_image = tube_upper_image_unscaled.Scale(tube_width, window_height - tube_gap);
tube_lower_image = tube_lower_image_unscaled.Scale(tube_width, window_height - tube_gap);
display_game_over = Sprite();

# debug
debug_sprite = Sprite();
debug_sprite.SetPosition(100, 100, TEXT_LEVEL);
fun write(text)
{
  text_image = Image.Text(text, 0, 0, 0, 1, "Sans 20");
  debug_sprite.SetImage(text_image);
}
write("Score: 0");

# intersection
fun intersects(circle_x, circle_y, circle_r, rect_x, rect_y, rect_width, rect_height)
{
    # Find the closest point on the rectangle to the circle's center
    # Clamp circle_x between rect_x (left) and rect_x + rect_width (right)
    closestX = circle_x;
    if (closestX < rect_x) { closestX = rect_x; }
    else if (closestX > (rect_x + rect_width)) { closestX = rect_x + rect_width; }

    # Clamp circle_y between rect_y (top) and rect_y + rect_height (bottom)
    closestY = circle_y;
    if (closestY < rect_y) { closestY = rect_y; }
    else if (closestY > (rect_y + rect_height)) { closestY = rect_y + rect_height; }

    # Calculate the distance from closest point to circle center
    distanceX = circle_x - closestX;
    distanceY = circle_y - closestY;

    # If the distance is less than the circle's radius, an intersection occurs
    distanceSquared = (distanceX * distanceX) + (distanceY * distanceY);
    return (distanceSquared < (circle_r * circle_r));
}

# bird
bird = [];
bird.x = 100;
bird.y = 400;
bird.speed = 0;
bird_radius = bird_sprite_size / 2;
bird.update = fun (dt)
{
  bird_sprite.SetImage(bird_image.Scale(bird_sprite_size, bird_sprite_size - bird_compression_max*(bird.speed/speed_after_space)));
  bird.speed = bird.speed + acceleration * dt;
  bird.y = bird.y - bird.speed * dt;
  if (bird.y < 0)
  {
    bird.y = 0;
    bird.speed = 0;
  }
  else if (bird.y > window_height)
  {
    bird.y = window_height;
    bird.speed = 0;
  }
  bird_sprite.SetPosition(bird.x, bird.y, SPRITES_LEVEL);
};

# tubes
upper_tube_height = tube_upper_image.GetHeight();
lower_tube_height = tube_lower_image.GetHeight();
tubes = [];
total_tubes = Math.Int(window_width / distance_between_tubes) + 1;
logic_w = total_tubes * distance_between_tubes;
initial_padding = 900;
for (current_tube = 0; current_tube < total_tubes; current_tube += 1)
{
  tube = [];
  tube.x = distance_between_tubes * current_tube + initial_padding;
  tube.y = Math.Random() * (window_height - tube_gap);
  tube.tube_upper = Sprite();
  tube.tube_lower = Sprite();
  tube.tube_upper.SetImage(tube_upper_image);
  tube.tube_lower.SetImage(tube_lower_image);

  tube.update = fun (dt)
  {
    this.x = this.x - tube_speed * dt;
    if (this.x < -tube_width)
    {
      this.x += logic_w;
      this.y = Math.Random() * (window_height - tube_gap);
      score += 1;

      # write score
      write("Score: " + score);
    }
    this.tube_upper.SetPosition(this.x, this.y - upper_tube_height, SPRITES_LEVEL);
    this.tube_lower.SetPosition(this.x, this.y + tube_gap, SPRITES_LEVEL);
    
    # collision detection
    if (this.x > bird.x + bird_radius * 2)
    {
      # skip collision detection if tube is to the right of bird, performance optimization
      return;
    }
    bird_center_x = bird.x + bird_radius;
    bird_center_y = bird.y + bird_radius;
    upper_ty = this.y - upper_tube_height;
    lower_ty = this.y + tube_gap;
    if (intersects(bird_center_x, bird_center_y, bird_radius, this.x, upper_ty, tube_width, upper_tube_height) ||
        intersects(bird_center_x, bird_center_y, bird_radius, this.x, lower_ty, tube_width, lower_tube_height))
    {
      Window.SetBackgroundTopColor(1, 0, 0);
      Window.SetBackgroundBottomColor(1, 0, 0);
      game_over_image = Image.Text("GAME OVER", 0, 0, 0, 1, "Sans 64");
      display_game_over.SetPosition((window_width - game_over_image.GetWidth()) / 2, (window_height - game_over_image.GetHeight()) / 2, TEXT_LEVEL);
      display_game_over.SetImage(game_over_image);
      game_over = 1;
    }
  };
  tubes[current_tube] = tube;
  tube_spawn_point += distance_between_tubes;
}

# keyboard input
fun inkey_callback (key)
{
  if (key == " ")
  {
    bird.speed = speed_after_space;
  }
}

Plymouth.SetKeyboardInputFunction(inkey_callback);

last_duration = 0;
fun progress_callback (duration, progress)
{
  # do nothing if game over
  if (game_over == 1)
  {
    return;
  }

  # get delta time
  dt = duration - last_duration;
  if (dt > 0.1)
  {
    dt = 0.1;
  }

  # update bird
  bird.update(dt);

  # update tubes and check for collisions
  for (current_tube = 0; current_tube < total_tubes; current_tube += 1)
  {
    tubes[current_tube].update(dt);
  }
  last_duration = duration;
}

Plymouth.SetBootProgressFunction(progress_callback);