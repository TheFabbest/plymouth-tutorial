# ==========================================
# Theme Name: fullscreenimage
# Description: Displays a single fullscreen image. Keeps the aspect ratio of the image and centers it on the screen.
# Author: TheFabbest
#
# Features:
# - Multi-Screen Support: Works, but only first screen is used (defaults to monitor 0)
# - Password Prompt Support: No
# - Progress Display: No
# ========================================== 

# load image
img = Image("image.png");

# scale image
W = Window.GetWidth();
H = Window.GetHeight();

# find smallest scale factor to fit image in window
scale_factor = Math.Min(W / img.GetWidth(), H / img.GetHeight());
scaled_img = img.Scale(Math.Int(scale_factor * img.GetWidth()), Math.Int(scale_factor * img.GetHeight()));

# create sprite and set image
sprite = Sprite();
sprite.SetImage(scaled_img);

# position sprite in center of window
center_x = Math.Int((W - scaled_img.GetWidth()) / 2);
center_y = Math.Int((H - scaled_img.GetHeight()) / 2);
sprite.SetPosition(center_x, center_y, 1);