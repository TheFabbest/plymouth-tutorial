
# set a background color gradient
Window.SetBackgroundTopColor(0,0,0.6);
Window.SetBackgroundBottomColor(0,0,0.6);


# load pacman images
pacman_images = [];
for (i = 0; i < 4; i = i + 1) {
    pacman_images[i] = Image("pacman" + i + ".png");
}
pacman_sprite = Sprite(pacman_images[0]);

# use pacman to show progress
fun progress_callback(duration, progress)
{
    sprite_index = Math.Int(duration*4) % 4;
    pacman_sprite.SetImage(pacman_images[sprite_index]);
    pacman_sprite.SetPosition(progress * Window.GetWidth(), Window.GetHeight()/2, 0);
}

Plymouth.SetBootProgressFunction(progress_callback);