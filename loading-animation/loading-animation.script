# set a background color gradient
Window.SetBackgroundTopColor(0,0,0);
Window.SetBackgroundBottomColor(0,0,0);

# initialize the animation
frame = 0;
target_frame = 0;
shown = Sprite();
first_frame = Image("frame0.png");
shown.SetImage(first_frame);
shown.SetPosition(Math.Int((Window.GetWidth() - first_frame.GetWidth()) / 2), Math.Int((Window.GetHeight() - first_frame.GetHeight()) / 2), 1);
num_of_frames = 83; # hardcoded number of frames in the animation


fun progress_callback (duration, progress)
{
  target_frame = Math.Int(progress * num_of_frames);
}

Plymouth.SetBootProgressFunction(progress_callback);


fun refresh_callback ()
{
  if (target_frame > frame)
  {
    frame = frame + 1;
    shown.SetImage(Image("frame" + frame + ".png"));
  }
}

Plymouth.SetRefreshFunction(refresh_callback);