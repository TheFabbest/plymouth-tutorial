
# set a background color gradient
Window.SetBackgroundTopColor();
Window.SetBackgroundBottomColor(1,1,1);


# ------------------------- Refresh Callback --------------------------------

# 1. PRE-ALLOCATION: Load images once during startup
MAX_FRAME = 82;
frames = [];
i = 0;
while (i < MAX_FRAME) {
    loaded = Image("efbec43e-959e-4386-bc01-e01be9ce335b-" + i + ".png");
    frames[i] = loaded.Scale(128, 128);
    i = i + 1;
}

# 2. SPRITE SETUP
shown = Sprite(); # Set initial image
w = frames[0].GetWidth();
h = frames[0].GetHeight();
x = (Window.GetWidth() - w) / 2;
y = (Window.GetHeight() - h) / 2;
shown.SetPosition(x, y, 1);

# 3. ANIMATION LOGIC: Use a counter to slow down the animation
frame = 0;
timer = 0;
SPEED = 2; # Change this to control how fast it animates

fun refresh_callback()
{
    timer = timer + 1;
    if (timer >= SPEED) {
        frame = (frame + 1) % MAX_FRAME;
        
        shown.SetImage(frames[frame]);
        
        timer = 0;
    }
}

Plymouth.SetRefreshFunction(refresh_callback);
